import java.util.Scanner;

public class PrintTables {
    private static Employee searchEmployee(Employee[] employees, String id) {
        if (employees == null || id == null) return null;

        for (Employee employee : employees) {
            if (employee != null && employee.getId() != null
                    && employee.getId().equalsIgnoreCase(id)) {
                return employee;
            }
        }
        return null;
    }

    private static String fit(String value, int width) {
        String text = value == null ? "" : value;
        if (text.length() > width) text = text.substring(0, width);
        return String.format("%-" + width + "s", text);
    }

    private static String line(String... values) {
        StringBuilder result = new StringBuilder();
        for (String value : values) result.append(value);
        return result.toString();
    }

    private static void show(String title, String content, Scanner sc) {
        ConsoleUI console = new ConsoleUI();
        console.printResult(title, content, sc);
    }

    // 1. EVALUATIONS
    public static void printEvaluations(Employee[] employees, String id, Scanner sc) {
        Employee employee = searchEmployee(employees, id);
        StringBuilder content = new StringBuilder();

        if (employee == null) {
            content.append("Employee not found: ").append(id);
        } else {
            content.append(line(
                    fit("Month", 12), fit("Work", 10), fit("Attitude", 10),
                    fit("Discipline", 12), fit("Quality", 10), fit("Productivity", 14),
                    fit("Teamwork", 10), fit("Average", 10))).append('\n');
            content.append("-".repeat(98)).append('\n');

            Evaluation[] rows = employee.getEvaluations();
            boolean found = false;
            if (rows != null) {
                for (Evaluation e : rows) {
                    if (e != null) {
                        content.append(String.format("%-12s %-10.1f %-10.1f %-12.1f %-10.1f %-14.1f %-10.1f %-10.2f%n",
                                e.getMonth(), e.getWorkScore(), e.getAttitudeScore(),
                                e.getDisciplineScore(), e.getWorkQuality(), e.getProductivity(),
                                e.getTeamWork(), e.calculateEvaluationScore()));
                        found = true;
                    }
                }
            }
            if (!found) content.append("No evaluation data found.");
        }
        show("EVALUATION TABLE - " + id, content.toString(), sc);
    }

    // 2. CONTRACTS
    public static void printContracts(Employee[] employees, String id, Scanner sc) {
        Employee employee = searchEmployee(employees, id);
        StringBuilder content = new StringBuilder();

        if (employee == null) {
            content.append("Employee not found: ").append(id);
        } else {
            content.append(line(fit("Start Date", 18), fit("End Date", 18),
                    fit("Contract Type", 25), fit("Status", 20))).append('\n');
            content.append("-".repeat(81)).append('\n');

            Contract[] rows = employee.getContracts();
            boolean found = false;
            if (rows != null) {
                for (Contract c : rows) {
                    if (c != null) {
                        content.append(line(fit(String.valueOf(c.getStartDate()), 18),
                                fit(String.valueOf(c.getEndDate()), 18),
                                fit(String.valueOf(c.getType()), 25),
                                fit(String.valueOf(c.getStatus()), 20))).append('\n');
                        found = true;
                    }
                }
            }
            if (!found) content.append("No contract data found.");
        }
        show("CONTRACT TABLE - " + id, content.toString(), sc);
    }

    // 3. PAYROLLS
    public static void printPayrolls(Employee[] employees, String id, Scanner sc) {
        Employee employee = searchEmployee(employees, id);
        StringBuilder content = new StringBuilder();

        if (employee == null) {
            content.append("Employee not found: ").append(id);
        } else {
            content.append(line(fit("Month/Year", 12), fit("Base Salary", 14),
                    fit("Bonus", 12), fit("Allowance", 12), fit("Deduction", 12),
                    fit("Overtime Pay", 14), fit("Net Salary", 14))).append('\n');
            content.append("-".repeat(92)).append('\n');

            Payroll[] rows = employee.getPayrolls();
            boolean found = false;
            if (rows != null) {
                for (Payroll p : rows) {
                    if (p != null) {
                        content.append(String.format("%-12s %-14.2f %-12.2f %-12.2f %-12.2f %-14.2f %-14.2f%n",
                                p.getMonth() + "/" + p.getYear(), p.getBaseSalary(),
                                p.getBonus(), p.getAllowance(), p.getDeduction(),
                                p.calculateOvertimePay(), p.calculateNetSalary()));
                        found = true;
                    }
                }
            }
            if (!found) content.append("No payroll data found.");
        }
        show("PAYROLL TABLE - " + id, content.toString(), sc);
    }

